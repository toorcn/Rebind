{
  "name": "c3-revoke-theater",
  "version": "0.1.0",
  "description": "ETHGlobal Tokyo 2026: a job pool that pays out only when two different humans pass a server-checked World ID.",
  "private": true,
  "scripts": {
    "test": "node --import tsx --test tests/*.test.*",
    "dev": "tsx src/server.ts",
    "dev:foil": "FOIL_MODE=1 tsx src/server.ts",
    "foil-revoke": "tsx src/foil-revoke.ts",
    "win-revoke": "tsx src/win-revoke.ts",
    "film": "tsx src/film.ts",
    "self-pay": "tsx src/self-pay.ts",
    "chain-self-pay": "tsx src/chain-self-pay.ts",
    "chain-artifacts": "node contracts/gen-artifacts.mjs",
    "bundle:metamask": "esbuild src/metamask-entry.ts --bundle --format=esm --platform=browser --target=es2022 --outfile=public/metamask-connect.js",
    "typecheck": "tsc --noEmit",
    "bundle:spatial": "esbuild src/spatial-browser.js --bundle --splitting --format=esm --platform=browser --target=es2022 --minify --outdir=public/spatial --entry-names=main --chunk-names=scene-[hash]",
    "build": "npm run bundle:spatial",
    "dev:connected": "REBIND_HOSTED_WALLET=1 tsx src/server.ts"
  },
  "license": "ISC",
  "dependencies": {
    "@metamask/connect-evm": "^2.1.1",
    "express": "^5.2.1",
    "three": "^0.180.0",
    "viem": "^2.56.9"
  },
  "devDependencies": {
    "@types/express": "^5.0.6",
    "@types/node": "^26.6.3",
    "esbuild": "^0.28.2",
    "tsx": "^4.23.15",
    "typescript": "~5.9.2"
  }
}
